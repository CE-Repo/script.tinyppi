     The standard layout: the panel the dialog has always opened with, its
     choices stacked in the middle of the screen. The other six layouts are
     generated - see tools/gen_dialog_skins.py - because they are one
     arrangement six ways over; this one is drawn from its own background
     pieces rather than from the rounded rectangle they share, so it is
     written out here. -->
<window type="dialog">
    <defaultcontrol always="true">1001</defaultcontrol>
    <onload>Dialog.Close(fullscreenvideo,true)</onload>
    <onload>Dialog.Close(videoosd,true)</onload>
    <onload>Dialog.Close(seekbar,true)</onload>
    <onload>Dialog.Close(1159,true)</onload>
    <animation effect="fade" start="0" end="100" time="200" tween="cubic" easing="inout">WindowOpen</animation>
    <animation effect="fade" end="0" start="100" time="150">WindowClose</animation>
    <controls>
        <!-- Global background -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <visible>String.IsEqual(Window(10000).Property(TinyPPI.DialogPlaced),1)</visible>
            <texture colordiffuse="$INFO[Window(10000).Property(TinyPPI.DialogGlobalBackgroundColor)]">common/dot-1x1.png</texture>
        </control>

        <!-- Moved into place by ui.mode_select before anything is drawn: the
             window file can only name one position, and the panel would
             otherwise show at that one for a frame and then jump to the one
             the settings ask for. -->
        <control type="group" id="2">
            <left>725</left>
            <top>267</top>
            <width>471</width>
            <height>546</height>
            <control type="group">
                <left>0</left>
                <top>0</top>
                <width>471</width>
                <height>546</height>
                <visible>String.IsEqual(Window(10000).Property(TinyPPI.DialogPlaced),1)</visible>

                <!-- Panel -->
                <control type="group">
                    <left>0</left>
                    <top>0</top>
                    <width>23</width>
                    <height>546</height>
                    <control type="image">
                        <texture colordiffuse="$INFO[Window(10000).Property(TinyPPI.DialogBackgroundColor)]">background/dialog-bg-start.png</texture>
                    </control>
                </control>
                <control type="image">
                    <left>23</left>
                    <top>0</top>
                    <width>425</width>
                    <height>546</height>
                    <texture colordiffuse="$INFO[Window(10000).Property(TinyPPI.DialogBackgroundColor)]">common/dot-1x1.png</texture>
                </control>
                <control type="group">
                    <left>448</left>
                    <top>0</top>
                    <width>23</width>
                    <height>546</height>
                    <control type="image">
                        <texture colordiffuse="$INFO[Window(10000).Property(TinyPPI.DialogBackgroundColor)]">background/dialog-bg-end.png</texture>
                    </control>
                </control>

                <!-- Label -->
                <control type="group">
                    <visible>String.IsEqual(Window(10000).Property(TinyPPI.ShowHeaderTitle),1)</visible>
                    <left>35</left>
                    <top>37</top>
                    <control type="label">
                        <label>[B]VS10[/B]</label>
                        <font>font32</font>
                        <textcolor>$INFO[Window(10000).Property(TinyPPI.DialogHeaderColor)]</textcolor>
                        <aligny>top</aligny>
                    </control>
                </control>

                <!-- Chart icon -->
                <control type="group">
                    <visible>String.IsEqual(Window(10000).Property(TinyPPI.ShowHeaderIcon),1)</visible>
                    <left>400</left>
                    <top>43</top>
                    <control type="image">
                        <width>36</width>
                        <height>36</height>
                        <texture colordiffuse="$INFO[Window(10000).Property(TinyPPI.DialogHeaderIconColor)]">icons/vs10.png</texture>
                    </control>
                </control>

                <!-- Line -->
                <control type="group">
                    <visible>String.IsEqual(Window(10000).Property(TinyPPI.ShowLine),1)</visible>
                    <left>35</left>
                    <top>120</top>
                    <control type="image">
                        <width>400</width>
                        <height>1</height>
                        <texture colordiffuse="$INFO[Window(10000).Property(TinyPPI.DialogLineColor)]">common/dot-1x1.png</texture>
                    </control>
                </control>
                <control type="group">
                    <visible>String.IsEqual(Window(10000).Property(TinyPPI.ShowLine),1)</visible>
                    <left>35</left>
                    <top>509</top>
                    <control type="image">
                        <width>400</width>
                        <height>1</height>
                        <texture colordiffuse="$INFO[Window(10000).Property(TinyPPI.DialogLineColor)]">common/dot-1x1.png</texture>
                    </control>
                </control>

                <!-- SDR: no Dolby Vision or HDR10 to keep, so the choices are what VS10 can make of it -->
                <control type="group">
                    <visible>String.IsEmpty(Window(10000).Property(TinyPPI.HdrType)) + !String.IsEqual(Window(10000).Property(TinyPPI.HdrType),hdr10plus) + !String.Contains(Window(10000).Property(TinyPPI.HdrType),hlg) + !String.IsEqual(Window(10000).Property(TinyPPI.Hdr10PlusPresent),1)</visible>
                    <control type="button" id="1001">
                        <left>35</left>
                        <top>155</top>
                        <width>400</width>
                        <height>80</height>
                        <label>[B]$LOCALIZE[10116][/B]</label>
                        <align>center</align>
                        <font>font23_narrow</font>
                        <textcolor>$INFO[Window(10000).Property(TinyPPI.DialogTextColor)]</textcolor>
                        <selectedcolor>$INFO[Window(10000).Property(TinyPPI.DialogTextColor)]</selectedcolor>
                        <focusedcolor>$INFO[Window(10000).Property(TinyPPI.DialogFocusTextColor)]</focusedcolor>
                        <texturenofocus colordiffuse="00FFFFFF" border="40">common/button-white.png</texturenofocus>
                        <texturefocus colordiffuse="$INFO[Window(10000).Property(TinyPPI.DialogFocusColor)]" border="40">common/button-white.png</texturefocus>
                        <onup>1004</onup>
                        <ondown>1002</ondown>
                    </control>
                    <control type="button" id="1002">
                        <left>35</left>
                        <top>235</top>
                        <width>400</width>
                        <height>80</height>
                        <label>[B]Original[/B]</label>
                        <align>center</align>
                        <font>font23_narrow</font>
                        <textcolor>$INFO[Window(10000).Property(TinyPPI.DialogTextColor)]</textcolor>
                        <selectedcolor>$INFO[Window(10000).Property(TinyPPI.DialogTextColor)]</selectedcolor>
                        <focusedcolor>$INFO[Window(10000).Property(TinyPPI.DialogFocusTextColor)]</focusedcolor>
                        <texturenofocus colordiffuse="00FFFFFF" border="40">common/button-white.png</texturenofocus>
                        <texturefocus colordiffuse="$INFO[Window(10000).Property(TinyPPI.DialogFocusColor)]" border="40">common/button-white.png</texturefocus>
                        <onup>1001</onup>
                        <ondown>1003</ondown>
                    </control>
                    <control type="button" id="1003">
                        <left>35</left>
                        <top>315</top>
                        <width>400</width>
                        <height>80</height>
                        <label>[B]SDR → HDR10[/B]</label>
                        <align>center</align>
                        <font>font23_narrow</font>
                        <textcolor>$INFO[Window(10000).Property(TinyPPI.DialogTextColor)]</textcolor>
                        <selectedcolor>$INFO[Window(10000).Property(TinyPPI.DialogTextColor)]</selectedcolor>
                        <focusedcolor>$INFO[Window(10000).Property(TinyPPI.DialogFocusTextColor)]</focusedcolor>
                        <texturenofocus colordiffuse="00FFFFFF" border="40">common/button-white.png</texturenofocus>
                        <texturefocus colordiffuse="$INFO[Window(10000).Property(TinyPPI.DialogFocusColor)]" border="40">common/button-white.png</texturefocus>
                        <onup>1002</onup>
                        <ondown>1004</ondown>
                    </control>
                    <control type="button" id="1004">
                        <left>35</left>
                        <top>395</top>
                        <width>400</width>
                        <height>80</height>
                        <label>[B]SDR → Dolby Vision[/B]</label>
                        <align>center</align>
                        <font>font23_narrow</font>
                        <textcolor>$INFO[Window(10000).Property(TinyPPI.DialogTextColor)]</textcolor>
                        <selectedcolor>$INFO[Window(10000).Property(TinyPPI.DialogTextColor)]</selectedcolor>
                        <focusedcolor>$INFO[Window(10000).Property(TinyPPI.DialogFocusTextColor)]</focusedcolor>
                        <texturenofocus colordiffuse="00FFFFFF" border="40">common/button-white.png</texturenofocus>
                        <texturefocus colordiffuse="$INFO[Window(10000).Property(TinyPPI.DialogFocusColor)]" border="40">common/button-white.png</texturefocus>
                        <onup>1003</onup>
                        <ondown>1001</ondown>
                    </control>
                </control>

                <!-- HDR10 -->
                <control type="group">
                    <visible>String.IsEqual(Window(10000).Property(TinyPPI.HdrType),hdr10) + !String.IsEqual(Window(10000).Property(TinyPPI.HdrType),hdr10plus) + !String.Contains(Window(10000).Property(TinyPPI.HdrType),hlg) + !String.IsEqual(Window(10000).Property(TinyPPI.Hdr10PlusPresent),1)</visible>
                    <control type="button" id="1101">
                        <left>35</left>
                        <top>155</top>
                        <width>400</width>
                        <height>80</height>
                        <label>[B]$LOCALIZE[10116][/B]</label>
                        <align>center</align>
                        <font>font23_narrow</font>
                        <textcolor>$INFO[Window(10000).Property(TinyPPI.DialogTextColor)]</textcolor>
                        <selectedcolor>$INFO[Window(10000).Property(TinyPPI.DialogTextColor)]</selectedcolor>
                        <focusedcolor>$INFO[Window(10000).Property(TinyPPI.DialogFocusTextColor)]</focusedcolor>
                        <texturenofocus colordiffuse="00FFFFFF" border="40">common/button-white.png</texturenofocus>
                        <texturefocus colordiffuse="$INFO[Window(10000).Property(TinyPPI.DialogFocusColor)]" border="40">common/button-white.png</texturefocus>
                        <onup>1008</onup>
                        <ondown>1005</ondown>
                    </control>
                    <control type="button" id="1005">
                        <left>35</left>
                        <top>235</top>
                        <width>400</width>
                        <height>80</height>
                        <label>[B]HDR10 (Original)[/B]</label>
                        <align>center</align>
                        <font>font23_narrow</font>
                        <textcolor>$INFO[Window(10000).Property(TinyPPI.DialogTextColor)]</textcolor>
                        <selectedcolor>$INFO[Window(10000).Property(TinyPPI.DialogTextColor)]</selectedcolor>
                        <focusedcolor>$INFO[Window(10000).Property(TinyPPI.DialogFocusTextColor)]</focusedcolor>
                        <texturenofocus colordiffuse="00FFFFFF" border="40">common/button-white.png</texturenofocus>
                        <texturefocus colordiffuse="$INFO[Window(10000).Property(TinyPPI.DialogFocusColor)]" border="40">common/button-white.png</texturefocus>
                        <onup>1101</onup>
                        <ondown>1006</ondown>
                    </control>
                    <control type="button" id="1006">
                        <left>35</left>
                        <top>315</top>
                        <width>400</width>
                        <height>80</height>
                        <label>[B]HDR10 → SDR[/B]</label>
                        <align>center</align>
                        <font>font23_narrow</font>
                        <textcolor>$INFO[Window(10000).Property(TinyPPI.DialogTextColor)]</textcolor>
                        <selectedcolor>$INFO[Window(10000).Property(TinyPPI.DialogTextColor)]</selectedcolor>
                        <focusedcolor>$INFO[Window(10000).Property(TinyPPI.DialogFocusTextColor)]</focusedcolor>
                        <texturenofocus colordiffuse="00FFFFFF" border="40">common/button-white.png</texturenofocus>
                        <texturefocus colordiffuse="$INFO[Window(10000).Property(TinyPPI.DialogFocusColor)]" border="40">common/button-white.png</texturefocus>
                        <onup>1005</onup>
                        <ondown>1008</ondown>
                    </control>
                    <control type="button" id="1008">
                        <left>35</left>
                        <top>395</top>
                        <width>400</width>
                        <height>80</height>
                        <label>[B]HDR10 → Dolby Vision[/B]</label>
                        <align>center</align>
                        <font>font23_narrow</font>
                        <textcolor>$INFO[Window(10000).Property(TinyPPI.DialogTextColor)]</textcolor>
                        <selectedcolor>$INFO[Window(10000).Property(TinyPPI.DialogTextColor)]</selectedcolor>
                        <focusedcolor>$INFO[Window(10000).Property(TinyPPI.DialogFocusTextColor)]</focusedcolor>
                        <texturenofocus colordiffuse="00FFFFFF" border="40">common/button-white.png</texturenofocus>
                        <texturefocus colordiffuse="$INFO[Window(10000).Property(TinyPPI.DialogFocusColor)]" border="40">common/button-white.png</texturefocus>
                        <onup>1006</onup>
                        <ondown>1101</ondown>
                    </control>
                </control>

                <!-- Dolby Vision -->
                <control type="group">
                    <visible>String.Contains(Window(10000).Property(TinyPPI.HdrType),dolby) + !String.IsEqual(Window(10000).Property(TinyPPI.HdrType),hdr10plus) + !String.Contains(Window(10000).Property(TinyPPI.HdrType),hlg) + !String.IsEqual(Window(10000).Property(TinyPPI.Hdr10PlusPresent),1)</visible>
                    <control type="button" id="1201">
                        <left>35</left>
                        <top>155</top>
                        <width>400</width>
                        <height>80</height>
                        <label>[B]$LOCALIZE[10116][/B]</label>
                        <align>center</align>
                        <font>font23_narrow</font>
                        <textcolor>$INFO[Window(10000).Property(TinyPPI.DialogTextColor)]</textcolor>
                        <selectedcolor>$INFO[Window(10000).Property(TinyPPI.DialogTextColor)]</selectedcolor>
                        <focusedcolor>$INFO[Window(10000).Property(TinyPPI.DialogFocusTextColor)]</focusedcolor>
                        <texturenofocus colordiffuse="00FFFFFF" border="40">common/button-white.png</texturenofocus>
                        <texturefocus colordiffuse="$INFO[Window(10000).Property(TinyPPI.DialogFocusColor)]" border="40">common/button-white.png</texturefocus>
                        <onup>1013</onup>
                        <ondown>1012</ondown>
                    </control>
                    <control type="button" id="1012">
                        <left>35</left>
                        <top>275</top>
                        <width>400</width>
                        <height>80</height>
                        <label>[B]Dolby Vision (Original)[/B]</label>
                        <align>center</align>
                        <font>font23_narrow</font>
                        <textcolor>$INFO[Window(10000).Property(TinyPPI.DialogTextColor)]</textcolor>
                        <selectedcolor>$INFO[Window(10000).Property(TinyPPI.DialogTextColor)]</selectedcolor>
                        <focusedcolor>$INFO[Window(10000).Property(TinyPPI.DialogFocusTextColor)]</focusedcolor>
                        <texturenofocus colordiffuse="00FFFFFF" border="40">common/button-white.png</texturenofocus>
                        <texturefocus colordiffuse="$INFO[Window(10000).Property(TinyPPI.DialogFocusColor)]" border="40">common/button-white.png</texturefocus>
                        <onup>1201</onup>
                        <ondown>1013</ondown>
                    </control>
                    <control type="button" id="1013">
                        <left>35</left>
                        <top>395</top>
                        <width>400</width>
                        <height>80</height>
                        <label>[B]Dolby Vision → SDR[/B]</label>
                        <align>center</align>
                        <font>font23_narrow</font>
                        <textcolor>$INFO[Window(10000).Property(TinyPPI.DialogTextColor)]</textcolor>
                        <selectedcolor>$INFO[Window(10000).Property(TinyPPI.DialogTextColor)]</selectedcolor>
                        <focusedcolor>$INFO[Window(10000).Property(TinyPPI.DialogFocusTextColor)]</focusedcolor>
                        <texturenofocus colordiffuse="00FFFFFF" border="40">common/button-white.png</texturenofocus>
                        <texturefocus colordiffuse="$INFO[Window(10000).Property(TinyPPI.DialogFocusColor)]" border="40">common/button-white.png</texturefocus>
                        <onup>1012</onup>
                        <ondown>1201</ondown>
                    </control>
                </control>

                <!-- HDR10+ and HLG have no VS10 modes, and neither does a hybrid Dolby Vision grade - the overlay is all that is left to offer -->
                <control type="group">
                    <visible>String.IsEqual(Window(10000).Property(TinyPPI.HdrType),hdr10plus) | String.Contains(Window(10000).Property(TinyPPI.HdrType),hlg) | String.IsEqual(Window(10000).Property(TinyPPI.Hdr10PlusPresent),1)</visible>
                    <control type="button" id="1301">
                        <left>35</left>
                        <top>275</top>
                        <width>400</width>
                        <height>80</height>
                        <label>[B]$LOCALIZE[10116][/B]</label>
                        <align>center</align>
                        <font>font23_narrow</font>
                        <textcolor>$INFO[Window(10000).Property(TinyPPI.DialogTextColor)]</textcolor>
                        <selectedcolor>$INFO[Window(10000).Property(TinyPPI.DialogTextColor)]</selectedcolor>
                        <focusedcolor>$INFO[Window(10000).Property(TinyPPI.DialogFocusTextColor)]</focusedcolor>
                        <texturenofocus colordiffuse="00FFFFFF" border="40">common/button-white.png</texturenofocus>
                        <texturefocus colordiffuse="$INFO[Window(10000).Property(TinyPPI.DialogFocusColor)]" border="40">common/button-white.png</texturefocus>
                        <onup>1301</onup>
                        <ondown>1301</ondown>

msgctxt "#32000"
msgid "General"
msgstr "Általános"

msgctxt "#32001"
msgid "TinyPPI settings"
msgstr "Beállítások"

msgctxt "#32002"
msgid "Launch"
msgstr "Indítás"

msgctxt "#32003"
msgid "Launch mode"
msgstr "Futtatás módja"

msgctxt "#32004"
msgid "Choose what opens when the add-on is launched."
msgstr "Válaszd ki, hogy mi nyíljon meg a kiegészítő indításakor."

msgctxt "#32005"
msgid "TinyPPI"
msgstr "TinyPPI"

msgctxt "#32006"
msgid "VS10 dialog"
msgstr "VS10 dialóg"

msgctxt "#32007"
msgid "Auto-hide"
msgstr "Automatikus elrejtés"

msgctxt "#32008"
msgid "Automatically hides the TinyPPI overlay after the selected time (in seconds). 0 = off. Does not apply to the VS10 dialog."
msgstr "Automatikusan elrejti a TinyPPI panelt a kiválasztott idő (másodpercben) elteltével. 0 = ki. Nem vonatkozik a VS10 panelre."

msgctxt "#32009"
msgid "Overlay content"
msgstr "Panel tartalom"

msgctxt "#32010"
msgid "Show file name"
msgstr "Fájlnév mutatása"

msgctxt "#32011"
msgid "Show the currently playing file name in TinyPPI."
msgstr "Mutasd az aktuálisan lejátszott fájl nevét."

msgctxt "#32012"
msgid "Show L5 offsets icon"
msgstr "L5 vágás ikon mutatása"

msgctxt "#32013"
msgid "Show the L5 offsets icon (lrtb) next to the L5 values."
msgstr "Jelenítsd meg az L5 vágás ikonját az L5 értékek mellett."

msgctxt "#32014"
msgid "Brightness unit"
msgstr "Fényerő egység"

msgctxt "#32015"
msgid "Choose the unit shown for the L6 brightness values."
msgstr "Válaszd ki az L6 fényerőértékeihez megjelenített mértékegységet."

msgctxt "#32016"
msgid "cd/m²"
msgstr "cd/m²"

msgctxt "#32017"
msgid "nits"
msgstr "nit"

msgctxt "#32018"
msgid "Hidden"
msgstr "Rejtve"

msgctxt "#32019"
msgid "Overlay position"
msgstr "Megejelenített pozíció"

msgctxt "#32020"
msgid "Horizontal offset (SDR only)"
msgstr "Vízszintes eltolás (csak SDR)"

msgctxt "#32021"
msgid "Shifts the overlay to the right from its default position. 100% is the maximum shift that keeps the content on screen."
msgstr "A panelt jobbra tolja az alapértelmezett pozíciójához képest. A 100% a maximális eltolás, amelynél a tartalom a még képernyőn marad."

msgctxt "#32022"
msgid "Vertical offset"
msgstr "Függőleges eltolás"

msgctxt "#32023"
msgid "Shifts the overlay upwards from its default position. 100% is the maximum shift that keeps the content on screen."
msgstr "Felfelé tolja a panelt az alapértelmezett pozíciójából. A 100% a maximális eltolás, amely még a képernyőn tartja a tartalmat."

msgctxt "#32024"
msgid "Move with the arrow keys"
msgstr "Mozgatás az iránygombokkal"

msgctxt "#32025"
msgid "Lets the arrow keys on the remote move the TinyPPI overlay around the screen while it is open. The move is not saved: the next launch starts from the position configured above."
msgstr "Lehetővé teszi, hogy a távirányító iránygombjaival mozgasd a TinyPPI réteget a képernyőn, amíg nyitva van. A mozgatás nem kerül mentésre: a következő indításkor újra a fent beállított pozíció érvényes."

msgctxt "#32026"
msgid "Converted output"
msgstr "Átalakított kimenet"

msgctxt "#32027"
msgid "Keep the HDR/DV area when converting to SDR"
msgstr "A HDR/DV terület megtartása SDR-re alakításkor"

msgctxt "#32028"
msgid "Keeps the HDR static-metadata and Dolby Vision panels on screen while VS10 converts the source to SDR. Turn off to draw the overlay in its SDR layout instead."
msgstr "A képernyőn tartja a statikus HDR-metaadatok és a Dolby Vision paneljeit, miközben a VS10 SDR-re alakítja a forrást. Kikapcsolva az átfedés az SDR-elrendezésben jelenik meg."

msgctxt "#32029"
msgid "Keep the Dolby Vision area when converting to HDR10"
msgstr "A Dolby Vision terület megtartása HDR10-re alakításkor"

msgctxt "#32030"
msgid "Keeps the Dolby Vision panels on screen while VS10 converts a Dolby Vision source to HDR10. Turn off to show the HDR static-metadata panel instead."
msgstr "A képernyőn tartja a Dolby Vision paneljeit, miközben a VS10 HDR10-re alakít egy Dolby Vision forrást. Kikapcsolva helyette a statikus HDR-metaadatok panelje jelenik meg."

msgctxt "#32031"
msgid "TinyPPI overlay"
msgstr "TinyPPI panel"

msgctxt "#32032"
msgid "Customise the TinyPPI overlay colors."
msgstr "Testreszabhatod a TinyPPI színeit."

msgctxt "#32033"
msgid "Global background"
msgstr "Általános háttér"

msgctxt "#32034"
msgid "Color of the full-screen global background."
msgstr "A teljes képernyős általános háttér színe."

msgctxt "#32035"
msgid "Transparency"
msgstr "Átlátszóság"

msgctxt "#32036"
msgid "Opacity of the full-screen background behind the overlay, from 0% (off) to 100% (fully opaque)."
msgstr "A teljes képernyős háttér átlátszatlansága a kijelzés mögött, 0%-tól (kikapcsolva) 100%-ig (teljesen átlátszatlan)."

msgctxt "#32037"
msgid "Background"
msgstr "Háttér"

msgctxt "#32038"
msgid "Background color of the overlay style."
msgstr "A háttér-panel háttérszíne."

msgctxt "#32039"
msgid "Opacity of the overlay background, from 0% (fully transparent) to 100% (fully opaque)."
msgstr "A panel hátterének átlátszósága 0%-tól (teljesen átlátszó) 100%-ig (teljesen átlátszatlan)."

msgctxt "#32040"
msgid "Title"
msgstr "Cím"

msgctxt "#32041"
msgid "Color of the section titles."
msgstr "A szakaszcímek színe."

msgctxt "#32042"
msgid "Opacity of this element, from 0% (fully transparent) to 100% (fully opaque)."
msgstr "Az elem átlátszósága 0%-tól (teljesen átlátszó) 100%-ig (teljesen átlátszatlan) terjedhet."

msgctxt "#32043"
msgid "Header title"
msgstr "Fejléc címke"

msgctxt "#32044"
msgid "Color of the overlay header label (Modern)."
msgstr "Az fejléc címke színe (Modern)."

msgctxt "#32045"
msgid "Description"
msgstr "Leírás"

msgctxt "#32046"
msgid "Color of the label descriptions."
msgstr "A címkeleírások színe."

msgctxt "#32047"
msgid "Output"
msgstr "Kimenet"

msgctxt "#32048"
msgid "Color of the output values."
msgstr "A kimenetek színe"

msgctxt "#32049"
msgid "Changed values"
msgstr "Változott értékek"

msgctxt "#32050"
msgid "Color for the readings that just changed. A value that moved is written in this color until the highlight duration below runs out, so the live readings can be told from the ones that do not move."
msgstr "Az éppen megváltozott értékek színe. A megváltozott érték ebben a színben jelenik meg, amíg az alábbi kiemelési időtartam le nem telik, így a mozgó értékek megkülönböztethetők az állóktól."

msgctxt "#32051"
msgid "Highlight duration"
msgstr "Kiemelés időtartama"

msgctxt "#32052"
msgid "How long a reading that just changed stays in the highlight color, in milliseconds. The readings behind it are still read ten times a second whatever this is set to, so no change is missed; at 100 the highlight lasts a single refresh, which is too brief to follow."
msgstr "Meddig marad a kiemelés színében egy éppen megváltozott érték, ezredmásodpercben. Maguk az értékek ettől függetlenül másodpercenként tízszer frissülnek, így egyetlen változás sem vész el; 100 esetén a kiemelés egyetlen frissítésig tart, ami túl rövid ahhoz, hogy követni lehessen."

msgctxt "#32053"
msgid "File name"
msgstr "Fájlnév"

msgctxt "#32054"
msgid "Color of the playing file name."
msgstr "A lejátszott fájl nevének a színe."

msgctxt "#32055"
msgid "FPS"
msgstr "FPS"

msgctxt "#32056"
msgid "Color of the In / drop / out FPS values."
msgstr "A bejövő / kieső / kimenő FPS értékek színe."

msgctxt "#32057"
msgid "Unit (cd/m², nits)"
msgstr "Mértékegység (cd/m², nit)"

msgctxt "#32058"
msgid "Color of the cd/m² brightness unit."
msgstr "A cd/m² fényerőegység színe."

msgctxt "#32059"
msgid "Detail"
msgstr "Részletek"

msgctxt "#32060"
msgid "Color of the dimmed detail values shown in parentheses."
msgstr "A zárójelben látható halványított értékek színe."

msgctxt "#32061"
msgid "Icon"
msgstr "Ikon"

msgctxt "#32062"
msgid "Color of the section icons."
msgstr "Ikonok színe"

msgctxt "#32063"
msgid "Header icon"
msgstr "Fejléc ikon"

msgctxt "#32064"
msgid "Color of the chart icon (Modern)."
msgstr "A diagram ikonjának színe (Modern)."

msgctxt "#32065"
msgid "Progress bar"
msgstr "Folyamatjelző sáv"

msgctxt "#32066"
msgid "Color of the progress bars."
msgstr "A progressbar színe"

msgctxt "#32067"
msgid "Separator line"
msgstr "Elválasztó"

msgctxt "#32068"
msgid "Color of the separator lines."
msgstr "Elválasztó színe"

msgctxt "#32069"
msgid "Conversion (yes)"
msgstr "Konverzió (igen)"

msgctxt "#32070"
msgid "Color of the check-circle icon shown when conversion is active."
msgstr "A pipa-kör ikon színe, amely aktív konverzió esetén látható."

msgctxt "#32071"
msgid "Conversion (no)"
msgstr "Konverzió (nem)"

msgctxt "#32072"
msgid "Color of the cross-circle icon shown when conversion is inactive."
msgstr "Az x-kör ikon színe, amely inaktív konverzió esetén látható."

msgctxt "#32073"
msgid "FEL tag"
msgstr "FEL réteg"

msgctxt "#32074"
msgid "Color of the FEL enhancement-layer tag in the input."
msgstr "A FEL réteg kijelzésének színe a bemeneten."

msgctxt "#32075"
msgid "MEL tag"
msgstr "MEL réteg"

msgctxt "#32076"
msgid "Color of the MEL enhancement-layer tag in the input."
msgstr "A MEL réteg kijelzésének színe a bemeneten."

msgctxt "#32077"
msgid "DV metadata"
msgstr "DV metaadatok"

msgctxt "#32078"
msgid "Diagnostic views for reading what a stream actually carries."
msgstr "Diagnosztikai nézetek annak megtekintéséhez, hogy egy adatfolyam valójában mit hordoz."

msgctxt "#32079"
msgid "Dolby Vision metadata"
msgstr "Dolby Vision metaadatok"

msgctxt "#32080"
msgid "Dolby Vision metadata view"
msgstr "Dolby Vision metaadat-nézet"

msgctxt "#32081"
msgid "Lets OK open the Dolby Vision metadata view while the TinyPPI overlay is up and a Dolby Vision source is playing. It lists every block the stream's side data carries — the configuration record, the RPU from its header through L11, the trim passes and the static SEIs. OK opens the section under the cursor in a window of its own, Back returns to the TinyPPI overlay. On any other source OK does nothing."
msgstr "Az OK gomb megnyitja a Dolby Vision metaadat-nézetet, amíg a TinyPPI-átfedés látható és Dolby Vision forrás játszik. Felsorolja az adatfolyam oldalsó adatainak minden blokkját – a konfigurációs rekordot, az RPU-t a fejlécétől L11-ig, a trimmeléseket és a statikus SEI-ket. Az OK a kijelölt szakaszt saját ablakban nyitja meg, a Vissza visszatér a TinyPPI-átfedéshez. Más forrásoknál az OK nem csinál semmit."

msgctxt "#32082"
msgid "Color laid over the whole screen behind the Dolby Vision metadata view. Raise its opacity to dim the picture behind it."
msgstr "A Dolby Vision metaadat-nézet mögött az egész képernyőre helyezett szín. Növeld az átlátszatlanságát a mögötte lévő kép sötétítéséhez."

msgctxt "#32083"
msgid "Background color of the metadata view itself."
msgstr "Magának a metaadat-nézetnek a háttérszíne."

msgctxt "#32084"
msgid "Color of the heading at the top of the metadata view."
msgstr "A metaadat-nézet tetején lévő cím színe."

msgctxt "#32085"
msgid "Color of the Dolby Vision logo in the top right corner."
msgstr "A jobb felső sarokban lévő Dolby Vision logó színe."

msgctxt "#32086"
msgid "Color of the section headings, such as RPU or L2 — Trims."
msgstr "A szakaszcímek színe, például RPU vagy L2 — Trims."

msgctxt "#32087"
msgid "Column headings"
msgstr "Oszlopfejlécek"

msgctxt "#32088"
msgid "Color of the column headings in the trim tables: Slope, Offset, Power and the rest."
msgstr "A trim táblázatok oszlopfejléceinek színe: Slope, Offset, Power és a többi."

msgctxt "#32089"
msgid "Color of the field names down the left column."
msgstr "A bal oldali oszlopban lévő mezőnevek színe."

msgctxt "#32090"
msgid "Color of the readings. A value that just changed is written in the \"Changed values\" color instead, for as long as it keeps changing."
msgstr "A leolvasott értékek színe. Az éppen megváltozott érték helyette a \"Változott értékek\" színével jelenik meg, amíg változik."

msgctxt "#32091"
msgid "Color of the rules under the section headings and above and below the list."
msgstr "A szakaszcímek alatti, valamint a lista fölötti és alatti vonalak színe."

msgctxt "#32092"
msgid "Selection"
msgstr "Kiválasztás"

msgctxt "#32093"
msgid "Color of the bar behind the row the selection is on."
msgstr "A kijelölés alatti sor mögötti sáv színe."

msgctxt "#32094"
msgid "Scrollbar"
msgstr "Görgetősáv"

msgctxt "#32095"
msgid "Color of the scrollbar down the right-hand edge."
msgstr "A jobb szélen lévő görgetősáv színe."

msgctxt "#32096"
msgid "Key hint"
msgstr "Billentyű-súgó"

msgctxt "#32097"
msgid "Color of the line at the bottom naming what the keys do."
msgstr "Az alul lévő sor színe, amely a billentyűk funkcióját nevezi meg."

msgctxt "#32098"
msgid "Codec logos"
msgstr "Kodek logók"

msgctxt "#32099"
msgid "Codec logos shown on the picture when playback starts or the OSD is open."
msgstr "A kodek logók megjelennek a képen, amikor a lejátszás elindul, vagy a képernyőmenü meg van nyitva."

msgctxt "#32100"
msgid "On playback start"
msgstr "Lejátszás indításakor"

msgctxt "#32101"
msgid "Show codec logos on playback start"
msgstr "Kodek logók megjelenítése lejátszás indításakor"

msgctxt "#32102"
msgid "When a video starts, briefly shows the audio format and HDR/video format logos in the top-right corner."
msgstr "Amikor egy videó elindul, rövid időre megjelenik a hangformátum és a HDR/videoformátum logója a jobb felső sarokban."

msgctxt "#32103"
msgid "Display duration (seconds)"
msgstr "Megjelenítési időtartam (másodperc)"

msgctxt "#32104"
msgid "How long the format logos stay on screen before they disappear."
msgstr "Mennyi ideig maradnak a logók a képernyőn, mielőtt eltűnnek."

msgctxt "#32105"
msgid "Show video codec logo"
msgstr "Videó kodek logó megjelenítése"

msgctxt "#32106"
msgid "Includes the HDR/video format logo in the stack. Turn it off to show the audio format logo on its own."
msgstr "A HDR/videó formátum logóját is megjeleníti. Kikapcsolva csak az audió formátum logója látszik."

msgctxt "#32107"
msgid "Show audio codec logo"
msgstr "Audió kodek logó megjelenítése"

msgctxt "#32108"
msgid "Includes the audio format logo in the stack. Turn it off to show the HDR/video format logo on its own."
msgstr "Az audió formátum logóját is megjeleníti. Kikapcsolva csak a HDR/videó formátum logója látszik."

msgctxt "#32109"
msgid "Logo order"
msgstr "Logók sorrendje"

msgctxt "#32110"
msgid "Which of the two logos sits on top of the stack."
msgstr "Melyik logó legyen a kettő közül felül."

msgctxt "#32111"
msgid "Video on top, audio below"
msgstr "Videó felül, audió alul"

msgctxt "#32112"
msgid "Audio on top, video below"
msgstr "Audió felül, videó alul"

msgctxt "#32113"
msgid "Dolby Vision pill position"
msgstr "Dolby Vision hasáb helye"

msgctxt "#32114"
msgid "Which edge of the logo panel the Dolby Vision layer pill sits on."
msgstr "A logópanel melyik szélén legyen a Dolby Vision réteg hasábja."

msgctxt "#32115"
msgid "Bottom edge"
msgstr "Alsó szél"

msgctxt "#32116"
msgid "Top edge"
msgstr "Felső szél"

msgctxt "#32117"
msgid "Horizontal offset"
msgstr "Vízszintes eltolás"

msgctxt "#32118"
msgid "Moves the logos from the left edge (0%) to the right edge (100%) of the screen."
msgstr "A logókat a képernyő bal széléről (0%) a jobb szélére (100%) mozgatja."

msgctxt "#32119"
msgid "Vertical offset"
msgstr "Függőleges eltolás"

msgctxt "#32120"
msgid "Moves the logos from the top edge (0%) to the bottom edge (100%) of the screen."
msgstr "A logókat a képernyő felső széléről (0%) az alsó szélére (100%) helyezi át."

msgctxt "#32121"
msgid "Size (%)"
msgstr "Méret (%)"

msgctxt "#32122"
msgid "Scales the format logos. 100% is the default size; lower values shrink them, higher values enlarge them. The horizontal and vertical offset are kept."
msgstr "Méretezi a logókat. A 100% az alapértelmezett méret; alacsonyabb értékek kicsinyítik, magasabb értékek növelik őket. A vízszintes és függőleges eltolás megmarad."

msgctxt "#32123"
msgid "Background color"
msgstr "Háttérszín"

msgctxt "#32124"
msgid "Color and transparency of the panel behind the logos."
msgstr "A logók mögötti panel színe és átlátszósága."

msgctxt "#32125"
msgid "Video logo"
msgstr "Videó logó"

msgctxt "#32126"
msgid "Color and transparency of the HDR/video format logo."
msgstr "A HDR/videó formátum logók színe és átlátszósága."

msgctxt "#32127"
msgid "Audio logo"
msgstr "Audió logó"

msgctxt "#32128"
msgid "Color and transparency of the audio format logo."
msgstr "Az audió formátum logók színe és átlátszósága."

msgctxt "#32129"
msgid "Divider"
msgstr "Elválasztó"

msgctxt "#32130"
msgid "Color and transparency of the divider line between the two logos."
msgstr "A két logó közötti elválasztó vonal színe és átlátszósága."

msgctxt "#32131"
msgid "Conversion indicator"
msgstr "Konverziójelző"

msgctxt "#32132"
msgid "Color of the dot shown on the video-format logo while a conversion is active."
msgstr "A videoformátum-logón megjelenő kör színe, amíg aktív egy konverzió."

msgctxt "#32133"
msgid "FEL indicator"
msgstr "FEL jelző"

msgctxt "#32134"
msgid "Color of the pill shown on the splash logo when the source is Dolby Vision FEL."
msgstr "A splash logón megjelenő hasáb színe, ha a forrás Dolby Vision FEL."

msgctxt "#32135"
msgid "MEL indicator"
msgstr "MEL jelző"

msgctxt "#32136"
msgid "Color of the pill shown on the splash logo when the source is Dolby Vision MEL."
msgstr "A splash logón megjelenő hasáb színe, ha a forrás Dolby Vision MEL."

msgctxt "#32137"
msgid "Other Dolby Vision"
msgstr "Egyéb Dolby Vision"

msgctxt "#32138"
msgid "Color of the pill shown on the splash logo for any other Dolby Vision profile (no enhancement layer)."
msgstr "A splash logón megjelenő hasáb színe minden más Dolby Vision profilhoz (enhancement layer nélkül)."

msgctxt "#32139"
msgid "Video OSD"
msgstr "Videó OSD"

msgctxt "#32140"
msgid "Show codec logos in the video OSD"
msgstr "Kodek logók megjelenítése a videó OSD-vel"

msgctxt "#32141"
msgid "Also shows the format logos whenever the on-screen playback controls (video OSD) are visible."
msgstr "A logókat megjeleníti, amikor a képernyőn megjelenő lejátszó-vezérlők (video OSD) láthatók."

msgctxt "#32142"
msgid "Show codec logos in the TinyPPI overlay"
msgstr "Kodek logók megjelenítése a TinyPPI panellel"

msgctxt "#32143"
msgid "Also shows the format logos while the TinyPPI info overlay is open."
msgstr "A formátumlogókat is megjeleníti, miközben a TinyPPI panel meg van nyitva."

msgctxt "#32144"
msgid "Layout"
msgstr "Elrendezés"

msgctxt "#32145"
msgid "Dialog layout"
msgstr "Párbeszédpanel elrendezése"

msgctxt "#32146"
msgid "Which of the designs the VS10 dialog is drawn as."
msgstr "Meghatározza, melyik kivitelben jelenik meg a VS10 párbeszédpanel."

msgctxt "#32147"
msgid "Single button"
msgstr "Egyetlen gomb"

msgctxt "#32148"
msgid "Bar"
msgstr "Sáv"

msgctxt "#32149"
msgid "Dialog"
msgstr "Párbeszédpanel"

msgctxt "#32150"
msgid "Dialog position"
msgstr "Párbeszédpanel helyzete"

msgctxt "#32151"
msgid "Vertical position"
msgstr "Függőleges helyzet"

msgctxt "#32152"
msgid "Where the dialog sits between the top edge of the screen (0%) and the bottom one (100%). 50% leaves it in the middle, where it has always been."
msgstr "Megadja, hol helyezkedjen el a párbeszédpanel a képernyő teteje (0%) és alja (100%) között. 50% esetén középen marad, ahol eddig is volt."

msgctxt "#32153"
msgid "Horizontal position"
msgstr "Vízszintes helyzet"

msgctxt "#32154"
msgid "Where the dialog sits between the left edge of the screen (0%) and the right one (100%). 50% leaves it in the middle."
msgstr "Megadja, hol helyezkedjen el a párbeszédpanel a képernyő bal (0%) és jobb széle (100%) között. 50% esetén középen marad."

msgctxt "#32155"
msgid "Background color of the VS10 selection dialog panel."
msgstr "A VS10 kiválasztó panel háttérszíne."

msgctxt "#32156"
msgid "Color of the VS10 header label in the selection dialog."
msgstr "A VS10 fejléccímke színe a kiválasztó panelen."

msgctxt "#32157"
msgid "Color of the chart icon in the VS10 selection dialog."
msgstr "A diagram ikon színe a VS10 kiválasztó panelen."

msgctxt "#32158"
msgid "Color of the separator lines in the VS10 selection dialog."
msgstr "Az elválasztó vonalak színe a VS10 kiválasztó panelen."

msgctxt "#32159"
msgid "Button text"
msgstr "Gombfelirat"

msgctxt "#32160"
msgid "Text color of the buttons the remote is not sitting on in the VS10 dialog."
msgstr "A VS10 párbeszédpanel azon gombjainak szövegszíne, amelyeken nem áll a távirányító."

msgctxt "#32161"
msgid "Background color of the focused button in the VS10 dialog."
msgstr "A fókuszban lévő gomb háttérszíne a VS10 párbeszédpanelen."

msgctxt "#32162"
msgid "Selection text"
msgstr "Kiválasztás szövege"

msgctxt "#32163"
msgid "Text color of the focused button in the VS10 dialog."
msgstr "A fókuszban lévő gomb szövegszíne a VS10 párbeszédpanelen."

msgctxt "#32164"
msgid "Channels"
msgstr "Hangszóró ikonok"

msgctxt "#32165"
msgid "Customise the colors of the channel layout graphic."
msgstr "Testreszabhatod a hangszóró ikonok elrendezési grafikájának színeit."

msgctxt "#32166"
msgid "Display"
msgstr "Megjelenítés"

msgctxt "#32167"
msgid "Channels in SDR"
msgstr "Hangszóró ikonok SDR-nél"

msgctxt "#32168"
msgid "Show the channel layout graphic while playing SDR content."
msgstr "A hangszóró ikonok elrendezés grafikáinak megjelenítése SDR tartalom lejátszása közben."

msgctxt "#32169"
msgid "Channels in HDR10 / HLG / HDR10+"
msgstr "Hangszóró ikonok HDR10 / HLG / HDR10+ -nél"

msgctxt "#32170"
msgid "Show the channel layout graphic while playing HDR10, HLG or HDR10+ content."
msgstr "A hangszóró ikonok elrendezés grafikáinak megjelenítése HDR10, HLG vagy HDR10+ tartalom lejátszása közben."

msgctxt "#32171"
msgid "Channels in Dolby Vision"
msgstr "Hangszóró ikonok Dolby Vision-nél"

msgctxt "#32172"
msgid "Show the channel layout graphic while playing Dolby Vision content."
msgstr "A hangszóró ikonok elrendezés grafikáinak megjelenítése Dolby Vision tartalom lejátszása közben."

msgctxt "#32173"
msgid "Horizontal offset of the channel box"
msgstr "Hangszóró ikonok vízszintes eltolása"

msgctxt "#32174"
msgid "Moves the channel box in Dolby Vision to the right. 0% places it at the left edge, 100% keeps it in its default position on the right."
msgstr "Dolby Vision esetén jobbra mozgatja a hangszóró ikonokat. 0% beállítás esetén a bal szélre kerül, 100% esetén pedig az alapértelmezett jobb szélre."

msgctxt "#32175"
msgid "Background color of the channel box shown in Dolby Vision."
msgstr "Hangszóró ikonok panel háttérszíne Dolby Vision-ben."

msgctxt "#32176"
msgid "Layout"
msgstr "Elrendezés"

msgctxt "#32177"
msgid "Color of the speaker layout graphic behind the active channels."
msgstr "Az aktív hangszóró ikonok mögötti, elrendezési grafika színe."

msgctxt "#32178"
msgid "Color of the active channels in the layout graphic."
msgstr "Az aktív hangszóró ikonok színe az elrendezési grafikán."

msgctxt "#32179"
msgid "Dashboard"
msgstr "Vezérlőpult"

msgctxt "#32180"
msgid "A live view of the playing stream in a browser on your phone or laptop, so the picture itself stays untouched."
msgstr "A futó adatfolyam élő nézete böngészőben, telefonon vagy laptopon, miközben maga a kép érintetlen marad."

msgctxt "#32181"
msgid "Enable web dashboard"
msgstr "Webes vezérlőpult bekapcsolása"

msgctxt "#32182"
msgid "Serves the dashboard on this box's own address. Off by default; once it is on, anything on the same network can reach it, so do not forward its port to the internet."
msgstr "A vezérlőpultot a médialejátszó saját címén szolgálja ki. Alapból ki van kapcsolva; bekapcsolva bárki eléri az azonos hálózaton, ezért a portját ne továbbítsd az internetre."

msgctxt "#32183"
msgid "Port"
msgstr "Port"

msgctxt "#32184"
msgid "The port the dashboard listens on. Leave 8080 alone - Kodi's own web server usually has it."
msgstr "A port, amelyen a vezérlőpult figyel. A 8080-at hagyd válatozatlanul - azt általában a Kodi saját webkiszolgálója foglalja le."

msgctxt "#32185"
msgid "Show address and token"
msgstr "Cím és token megjelenítése"

msgctxt "#32186"
msgid "Shows the address to open in a browser, together with the current token."
msgstr "Megmutatja a böngészőben megnyitandó címet az aktuális tokennel együtt."

msgctxt "#32187"
msgid "Access token"
msgstr "Hozzáférési token"

msgctxt "#32188"
msgid "The key the dashboard asks for. Switching a VS10 mode from the browser always needs it; reading needs it only when the setting below says so."
msgstr "A kulcs, amelyet a vezérlőpult kér. A VS10-mód böngészőből való váltásához mindig kell; az olvasáshoz csak akkor, ha az alábbi beállítás így kéri."

msgctxt "#32189"
msgid "Generate a new token"
msgstr "Új token létrehozása"

msgctxt "#32190"
msgid "Replaces the token with a fresh one. Every browser still holding the old one is logged out."
msgstr "Frissre cseréli a tokent. Minden böngésző, amely még a régit mentette, kilép."

msgctxt "#32191"
msgid "Show the Dolby Vision metadata view"
msgstr "A Dolby Vision metaadat-nézet megjelenítése"

msgctxt "#32192"
msgid "Adds the full metadata list to the dashboard - every block the stream's side data carries, the same one the on-screen view shows. It is only built for a Dolby Vision source, and it is the largest thing the page sends, so turn it off on a slow network."
msgstr "Hozzáadja a teljes metaadatlistát a vezérlőpulthoz - minden blokkot, amit az adatfolyam mellékadatai hordoznak, ugyanazt, amit a képernyőn látható nézet mutat. Csak Dolby Vision forráshoz készül el, ez a legnagyobb, ami küldésre kerül, ezért lassú hálózaton kapcsold ki."

msgctxt "#32193"
msgid "Show the film library"
msgstr "Filmtár megjelenítése"

msgctxt "#32194"
msgid "Offers the films in the video library on the dashboard while nothing is playing. A press starts one on the box."
msgstr "A vezérlőpulton felkínálja a videótár filmjeit, amíg semmi nem megy. Egy koppintás elindítja az egyiket a boxon."

msgctxt "#32195"
msgid "Show the series library"
msgstr "Sorozattár megjelenítése"

msgctxt "#32196"
msgid "Offers the series in the video library on the dashboard while nothing is playing. A press opens one and starts an episode on the box."
msgstr "A vezérlőpulton felkínálja a videótár sorozatait, amíg semmi nem megy. Egy koppintás megnyit egyet, és elindít egy epizódot a boxon."

msgctxt "#32197"
msgid "Require the token for reading too"
msgstr "Token kérése olvasáshoz is"

msgctxt "#32198"
msgid "Asks for the token before showing anything at all, not just before switching a mode. Turn this on when the box is on a shared network."
msgstr "Már azelőtt kéri a tokent, hogy bármit megjelenítene, nem csak váltás előtt. Kapcsold be, ha a médialejátszó megosztott hálózaton van."

msgctxt "#32199"
msgid "Allow VS10 switching from the dashboard"
msgstr "VS10-váltás engedélyezése a vezérlőpultról"

msgctxt "#32200"
msgid "Shows the VS10 output modes for the playing source in the browser, so the mode can be switched from a phone. The token is required either way."
msgstr "Megjeleníti a futó forrás VS10 kimeneti módjait a böngészőben, így a mód telefonról is váltható. A token mindkét esetben szükséges."


msgid "Enter the access token"
msgstr "Add meg a hozzáférési tokent"

msgctxt "#32460"
msgid "You will find it in the add-on settings under Dashboard."
msgstr "A kiegészítő beállításaiban találod, a Vezérlőpult alatt."

msgctxt "#32461"

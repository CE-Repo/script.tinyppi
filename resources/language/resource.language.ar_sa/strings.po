msgctxt "#32000"
msgid "General"
msgstr "عام"

msgctxt "#32001"
msgid "TinyPPI settings"
msgstr "إعدادات TinyPPI"

msgctxt "#32002"
msgid "Launch"
msgstr "تشغيل"

msgctxt "#32003"
msgid "Launch mode"
msgstr "وضع التشغيل"

msgctxt "#32004"
msgid "Choose what opens when the add-on is launched."
msgstr "اختر ما يُفتح عند تشغيل الإضافة."

msgctxt "#32005"
msgid "TinyPPI"
msgstr "TinyPPI"

msgctxt "#32006"
msgid "VS10 dialog"
msgstr "حوار VS10"

msgctxt "#32007"
msgid "Auto-hide"
msgstr "إخفاء تلقائي"

msgctxt "#32008"
msgid "Automatically hides the TinyPPI overlay after the selected time (in seconds). 0 = off. Does not apply to the VS10 dialog."
msgstr "يُخفي طبقة TinyPPI تلقائيًا بعد الوقت المحدّد (بالثواني). 0 = متوقف. لا ينطبق على حوار VS10."

msgctxt "#32009"
msgid "Overlay content"
msgstr "محتوى الطبقة"

msgctxt "#32010"
msgid "Show file name"
msgstr "عرض اسم الملف"

msgctxt "#32011"
msgid "Show the currently playing file name in TinyPPI."
msgstr "عرض اسم الملف الجاري تشغيله في TinyPPI."

msgctxt "#32012"
msgid "Show L5 offsets icon"
msgstr "عرض أيقونة إزاحات L5"

msgctxt "#32013"
msgid "Show the L5 offsets icon (lrtb) next to the L5 values."
msgstr "عرض أيقونة إزاحات L5 (lrtb) بجوار قيم L5."

msgctxt "#32014"
msgid "Brightness unit"
msgstr "وحدة السطوع"

msgctxt "#32015"
msgid "Choose the unit shown for the L6 brightness values."
msgstr "اختر الوحدة المعروضة لقيم سطوع L6."

msgctxt "#32016"
msgid "cd/m²"
msgstr "cd/m²"

msgctxt "#32017"
msgid "nits"
msgstr "nits"

msgctxt "#32018"
msgid "Hidden"
msgstr "مخفي"

msgctxt "#32019"
msgid "Overlay position"
msgstr "موضع الطبقة"

msgctxt "#32020"
msgid "Horizontal offset (SDR only)"
msgstr "الإزاحة الأفقية (SDR فقط)"

msgctxt "#32021"
msgid "Shifts the overlay to the right from its default position. 100% is the maximum shift that keeps the content on screen."
msgstr "يزيح الطبقة إلى اليمين من موضعها الافتراضي. 100% هي أقصى إزاحة تبقي المحتوى على الشاشة."

msgctxt "#32022"
msgid "Vertical offset"
msgstr "الإزاحة العمودية"

msgctxt "#32023"
msgid "Shifts the overlay upwards from its default position. 100% is the maximum shift that keeps the content on screen."
msgstr "يزيح الطبقة إلى الأعلى من موضعها الافتراضي. 100% هي أقصى إزاحة تبقي المحتوى على الشاشة."

msgctxt "#32024"
msgid "Move with the arrow keys"
msgstr "التحريك بأزرار الاتجاهات"

msgctxt "#32025"
msgid "Lets the arrow keys on the remote move the TinyPPI overlay around the screen while it is open. The move is not saved: the next launch starts from the position configured above."
msgstr "يتيح تحريك طبقة TinyPPI على الشاشة بأزرار الاتجاهات في جهاز التحكم أثناء فتحها. لا يُحفظ التحريك: يبدأ التشغيل التالي من الموضع المضبوط أعلاه."

msgctxt "#32026"
msgid "Converted output"
msgstr "المخرج المحوَّل"

msgctxt "#32027"
msgid "Keep the HDR/DV area when converting to SDR"
msgstr "الإبقاء على منطقة HDR/DV عند التحويل إلى SDR"

msgctxt "#32028"
msgid "Keeps the HDR static-metadata and Dolby Vision panels on screen while VS10 converts the source to SDR. Turn off to draw the overlay in its SDR layout instead."
msgstr "يُبقي لوحتَي بيانات HDR الثابتة ودولبي فيجن ظاهرتين أثناء تحويل VS10 للمصدر إلى SDR. أوقفه لعرض التراكب بتخطيط SDR بدلاً من ذلك."

msgctxt "#32029"
msgid "Keep the Dolby Vision area when converting to HDR10"
msgstr "الإبقاء على منطقة دولبي فيجن عند التحويل إلى HDR10"

msgctxt "#32030"
msgid "Keeps the Dolby Vision panels on screen while VS10 converts a Dolby Vision source to HDR10. Turn off to show the HDR static-metadata panel instead."
msgstr "يُبقي لوحات دولبي فيجن ظاهرة أثناء تحويل VS10 لمصدر دولبي فيجن إلى HDR10. أوقفه لعرض لوحة بيانات HDR الثابتة بدلاً من ذلك."

msgctxt "#32031"
msgid "TinyPPI overlay"
msgstr "طبقة TinyPPI"

msgctxt "#32032"
msgid "Customise the TinyPPI overlay colors."
msgstr "تخصيص ألوان طبقة TinyPPI."

msgctxt "#32033"
msgid "Global background"
msgstr "خلفية عامة"

msgctxt "#32034"
msgid "Color of the full-screen global background."
msgstr "لون الخلفية العامة لملء الشاشة."

msgctxt "#32035"
msgid "Transparency"
msgstr "الشفافية"

msgctxt "#32036"
msgid "Opacity of the full-screen background behind the overlay, from 0% (off) to 100% (fully opaque)."
msgstr "شفافية خلفية ملء الشاشة خلف الطبقة، من 0% (متوقفة) إلى 100% (معتمة تمامًا)."

msgctxt "#32037"
msgid "Background"
msgstr "الخلفية"

msgctxt "#32038"
msgid "Background color of the overlay style."
msgstr "لون خلفية نمط الطبقة."

msgctxt "#32039"
msgid "Opacity of the overlay background, from 0% (fully transparent) to 100% (fully opaque)."
msgstr "شفافية خلفية الطبقة، من 0% (شفافة تمامًا) إلى 100% (معتمة تمامًا)."

msgctxt "#32040"
msgid "Title"
msgstr "العنوان"

msgctxt "#32041"
msgid "Color of the section titles."
msgstr "لون عناوين الأقسام."

msgctxt "#32042"
msgid "Opacity of this element, from 0% (fully transparent) to 100% (fully opaque)."
msgstr "شفافية هذا العنصر، من 0% (شفاف تمامًا) إلى 100% (معتم تمامًا)."

msgctxt "#32043"
msgid "Header title"
msgstr "عنوان الرأس"

msgctxt "#32044"
msgid "Color of the overlay header label (Modern)."
msgstr "لون تسمية رأس الطبقة (حديث)."

msgctxt "#32045"
msgid "Description"
msgstr "الوصف"

msgctxt "#32046"
msgid "Color of the label descriptions."
msgstr "لون أوصاف التسميات."

msgctxt "#32047"
msgid "Output"
msgstr "الإخراج"

msgctxt "#32048"
msgid "Color of the output values."
msgstr "لون قيم الإخراج."

msgctxt "#32049"
msgid "Changed values"
msgstr "القيم المتغيّرة"

msgctxt "#32050"
msgid "Color for the readings that just changed. A value that moved is written in this color until the highlight duration below runs out, so the live readings can be told from the ones that do not move."
msgstr "لون القراءات التي تغيّرت للتو. تُكتب القيمة التي تغيّرت بهذا اللون إلى أن تنتهي مدة الإبراز أدناه، ليتسنى تمييز القراءات المتحركة عن الثابتة."

msgctxt "#32051"
msgid "Highlight duration"
msgstr "مدة الإبراز"

msgctxt "#32052"
msgid "How long a reading that just changed stays in the highlight color, in milliseconds. The readings behind it are still read ten times a second whatever this is set to, so no change is missed; at 100 the highlight lasts a single refresh, which is too brief to follow."
msgstr "المدة التي تبقى فيها القراءة التي تغيّرت للتو بلون الإبراز، بالمللي ثانية. تُقرأ القيم نفسها عشر مرات في الثانية مهما كان هذا الإعداد، فلا يضيع أي تغيير؛ وعند 100 يدوم الإبراز تحديثًا واحدًا فقط، وهي مدة أقصر من أن تُتابَع."

msgctxt "#32053"
msgid "File name"
msgstr "اسم الملف"

msgctxt "#32054"
msgid "Color of the playing file name."
msgstr "لون اسم الملف الجاري تشغيله."

msgctxt "#32055"
msgid "FPS"
msgstr "إطار/ث"

msgctxt "#32056"
msgid "Color of the In / drop / out FPS values."
msgstr "لون قيم إطار/ثانية للدخول / الإسقاط / الخروج."

msgctxt "#32057"
msgid "Unit (cd/m², nits)"
msgstr "الوحدة (cd/m²، nits)"

msgctxt "#32058"
msgid "Color of the cd/m² brightness unit."
msgstr "لون وحدة السطوع cd/m²."

msgctxt "#32059"
msgid "Detail"
msgstr "التفاصيل"

msgctxt "#32060"
msgid "Color of the dimmed detail values shown in parentheses."
msgstr "لون قيم التفاصيل الخافتة المعروضة بين قوسين."

msgctxt "#32061"
msgid "Icon"
msgstr "الأيقونة"

msgctxt "#32062"
msgid "Color of the section icons."
msgstr "لون أيقونات الأقسام."

msgctxt "#32063"
msgid "Header icon"
msgstr "أيقونة الرأس"

msgctxt "#32064"
msgid "Color of the chart icon (Modern)."
msgstr "لون أيقونة الرسم البياني (حديث)."

msgctxt "#32065"
msgid "Progress bar"
msgstr "شريط التقدّم"

msgctxt "#32066"
msgid "Color of the progress bars."
msgstr "لون أشرطة التقدّم."

msgctxt "#32067"
msgid "Separator line"
msgstr "خط الفاصل"

msgctxt "#32068"
msgid "Color of the separator lines."
msgstr "لون خطوط الفصل."

msgctxt "#32069"
msgid "Conversion (yes)"
msgstr "التحويل (نعم)"

msgctxt "#32070"
msgid "Color of the check-circle icon shown when conversion is active."
msgstr "لون أيقونة دائرة الاختيار المعروضة عند تفعيل التحويل."

msgctxt "#32071"
msgid "Conversion (no)"
msgstr "التحويل (لا)"

msgctxt "#32072"
msgid "Color of the cross-circle icon shown when conversion is inactive."
msgstr "لون أيقونة دائرة التقاطع المعروضة عند تعطيل التحويل."

msgctxt "#32073"
msgid "FEL tag"
msgstr "وسم FEL"

msgctxt "#32074"
msgid "Color of the FEL enhancement-layer tag in the input."
msgstr "لون وسم طبقة التحسين FEL في الإدخال."

msgctxt "#32075"
msgid "MEL tag"
msgstr "وسم MEL"

msgctxt "#32076"
msgid "Color of the MEL enhancement-layer tag in the input."
msgstr "لون وسم طبقة التحسين MEL في الإدخال."

msgctxt "#32077"
msgid "DV metadata"
msgstr "بيانات DV الوصفية"

msgctxt "#32078"
msgid "Diagnostic views for reading what a stream actually carries."
msgstr "طرق عرض تشخيصية لمعرفة ما يحمله الدفق فعليًا."

msgctxt "#32079"
msgid "Dolby Vision metadata"
msgstr "بيانات دولبي فيجن الوصفية"

msgctxt "#32080"
msgid "Dolby Vision metadata view"
msgstr "عرض بيانات دولبي فيجن الوصفية"

msgctxt "#32081"
msgid "Lets OK open the Dolby Vision metadata view while the TinyPPI overlay is up and a Dolby Vision source is playing. It lists every block the stream's side data carries — the configuration record, the RPU from its header through L11, the trim passes and the static SEIs. OK opens the section under the cursor in a window of its own, Back returns to the TinyPPI overlay. On any other source OK does nothing."
msgstr "يتيح فتح عرض بيانات دولبي فيجن الوصفية بالضغط على موافق أثناء ظهور واجهة TinyPPI وتشغيل مصدر دولبي فيجن. يعرض كل كتلة تحملها البيانات الجانبية للدفق: سجل الإعداد، وRPU من ترويسته حتى L11، وتمريرات الضبط، وبيانات SEI الثابتة. موافق يفتح القسم المحدد في نافذة خاصة به، ورجوع يعيدك إلى واجهة TinyPPI. مع المصادر الأخرى لا يفعل موافق شيئًا."

msgctxt "#32082"
msgid "Color laid over the whole screen behind the Dolby Vision metadata view. Raise its opacity to dim the picture behind it."
msgstr "لون يُوضع على الشاشة بأكملها خلف عرض بيانات دولبي فيجن الوصفية. ارفع درجة عتامته لتعتيم الصورة خلفه."

msgctxt "#32083"
msgid "Background color of the metadata view itself."
msgstr "لون خلفية عرض البيانات الوصفية نفسه."

msgctxt "#32084"
msgid "Color of the heading at the top of the metadata view."
msgstr "لون العنوان في أعلى عرض البيانات الوصفية."

msgctxt "#32085"
msgid "Color of the Dolby Vision logo in the top right corner."
msgstr "لون شعار دولبي فيجن في الزاوية العلوية اليمنى."

msgctxt "#32086"
msgid "Color of the section headings, such as RPU or L2 — Trims."
msgstr "لون عناوين الأقسام، مثل RPU أو L2 — Trims."

msgctxt "#32087"
msgid "Column headings"
msgstr "عناوين الأعمدة"

msgctxt "#32088"
msgid "Color of the column headings in the trim tables: Slope, Offset, Power and the rest."
msgstr "لون عناوين الأعمدة في جداول التعديل: Slope وOffset وPower وبقيتها."

msgctxt "#32089"
msgid "Color of the field names down the left column."
msgstr "لون أسماء الحقول في العمود الأيسر."

msgctxt "#32090"
msgid "Color of the readings. A value that just changed is written in the \"Changed values\" color instead, for as long as it keeps changing."
msgstr "لون القراءات. القيمة التي تغيّرت للتو تُكتب بلون \"القيم المتغيّرة\" بدلًا من ذلك، ما دامت تتغيّر."

msgctxt "#32091"
msgid "Color of the rules under the section headings and above and below the list."
msgstr "لون الخطوط أسفل عناوين الأقسام وفوق القائمة وتحتها."

msgctxt "#32092"
msgid "Selection"
msgstr "التحديد"

msgctxt "#32093"
msgid "Color of the bar behind the row the selection is on."
msgstr "لون الشريط خلف الصف الذي يقع عليه التحديد."

msgctxt "#32094"
msgid "Scrollbar"
msgstr "شريط التمرير"

msgctxt "#32095"
msgid "Color of the scrollbar down the right-hand edge."
msgstr "لون شريط التمرير على الحافة اليمنى."

msgctxt "#32096"
msgid "Key hint"
msgstr "تلميح المفاتيح"

msgctxt "#32097"
msgid "Color of the line at the bottom naming what the keys do."
msgstr "لون السطر في الأسفل الذي يذكر وظيفة المفاتيح."

msgctxt "#32098"
msgid "Codec logos"
msgstr "شعارات الترميز"

msgctxt "#32099"
msgid "Codec logos shown on the picture when playback starts or the OSD is open."
msgstr "شعارات الترميز المعروضة على الصورة عند بدء التشغيل أو فتح OSD."

msgctxt "#32100"
msgid "On playback start"
msgstr "عند بدء التشغيل"

msgctxt "#32101"
msgid "Show codec logos on playback start"
msgstr "عرض شعارات الترميز عند بدء التشغيل"

msgctxt "#32102"
msgid "When a video starts, briefly shows the audio format and HDR/video format logos in the top-right corner."
msgstr "عند بدء تشغيل فيديو، يعرض بإيجاز شعارات صيغة الصوت و HDR/الفيديو في الزاوية العلوية اليمنى."

msgctxt "#32103"
msgid "Display duration (seconds)"
msgstr "مدة العرض (ثوانٍ)"

msgctxt "#32104"
msgid "How long the format logos stay on screen before they disappear."
msgstr "المدة التي تبقى فيها شعارات الصيغة على الشاشة قبل اختفائها."

msgctxt "#32105"
msgid "Show video codec logo"
msgstr "عرض شعار ترميز الفيديو"

msgctxt "#32106"
msgid "Includes the HDR/video format logo in the stack. Turn it off to show the audio format logo on its own."
msgstr "يضيف شعار صيغة HDR/الفيديو إلى المجموعة. أوقفه لعرض شعار صيغة الصوت وحده."

msgctxt "#32107"
msgid "Show audio codec logo"
msgstr "عرض شعار ترميز الصوت"

msgctxt "#32108"
msgid "Includes the audio format logo in the stack. Turn it off to show the HDR/video format logo on its own."
msgstr "يضيف شعار صيغة الصوت إلى المجموعة. أوقفه لعرض شعار صيغة HDR/الفيديو وحده."

msgctxt "#32109"
msgid "Logo order"
msgstr "ترتيب الشعارات"

msgctxt "#32110"
msgid "Which of the two logos sits on top of the stack."
msgstr "يحدد أي الشعارين يظهر في الأعلى."

msgctxt "#32111"
msgid "Video on top, audio below"
msgstr "الفيديو في الأعلى والصوت في الأسفل"

msgctxt "#32112"
msgid "Audio on top, video below"
msgstr "الصوت في الأعلى والفيديو في الأسفل"

msgctxt "#32113"
msgid "Dolby Vision pill position"
msgstr "موضع شريط دولبي فيجن"

msgctxt "#32114"
msgid "Which edge of the logo panel the Dolby Vision layer pill sits on."
msgstr "الحافة التي يظهر عندها شريط طبقة دولبي فيجن من لوحة الشعارات."

msgctxt "#32115"
msgid "Bottom edge"
msgstr "الحافة السفلية"

msgctxt "#32116"
msgid "Top edge"
msgstr "الحافة العلوية"

msgctxt "#32117"
msgid "Horizontal offset"
msgstr "الإزاحة الأفقية"

msgctxt "#32118"
msgid "Moves the logos from the left edge (0%) to the right edge (100%) of the screen."
msgstr "يحرّك الشعارات من الحافة اليسرى (0%) إلى الحافة اليمنى (100%) للشاشة."

msgctxt "#32119"
msgid "Vertical offset"
msgstr "الإزاحة العمودية"

msgctxt "#32120"
msgid "Moves the logos from the top edge (0%) to the bottom edge (100%) of the screen."
msgstr "يحرّك الشعارات من الحافة العلوية (0%) إلى الحافة السفلية (100%) للشاشة."

msgctxt "#32121"
msgid "Size (%)"
msgstr "الحجم (%)"

msgctxt "#32122"
msgid "Scales the format logos. 100% is the default size; lower values shrink them, higher values enlarge them. The horizontal and vertical offset are kept."
msgstr "يقيس حجم شعارات الصيغة. 100% هو الحجم الافتراضي؛ القيم الأقل تصغّرها والأعلى تكبّرها. تبقى الإزاحة الأفقية والعمودية."

msgctxt "#32123"
msgid "Background color"
msgstr "لون الخلفية"

msgctxt "#32124"
msgid "Color and transparency of the panel behind the logos."
msgstr "لون وشفافية اللوحة خلف الشعارات."

msgctxt "#32125"
msgid "Video logo"
msgstr "شعار الفيديو"

msgctxt "#32126"
msgid "Color and transparency of the HDR/video format logo."
msgstr "لون وشفافية شعار صيغة HDR/الفيديو."

msgctxt "#32127"
msgid "Audio logo"
msgstr "شعار الصوت"

msgctxt "#32128"
msgid "Color and transparency of the audio format logo."
msgstr "لون وشفافية شعار صيغة الصوت."

msgctxt "#32129"
msgid "Divider"
msgstr "الفاصل"

msgctxt "#32130"
msgid "Color and transparency of the divider line between the two logos."
msgstr "لون وشفافية خط الفاصل بين الشعارين."

msgctxt "#32131"
msgid "Conversion indicator"
msgstr "مؤشر التحويل"

msgctxt "#32132"
msgid "Color of the dot shown on the video-format logo while a conversion is active."
msgstr "لون النقطة المعروضة على شعار صيغة الفيديو أثناء تفعيل تحويل."

msgctxt "#32133"
msgid "FEL indicator"
msgstr "مؤشر FEL"

msgctxt "#32134"
msgid "Color of the pill shown on the splash logo when the source is Dolby Vision FEL."
msgstr "لون الشريط المعروض على شعار البداية عندما يكون المصدر Dolby Vision FEL."

msgctxt "#32135"
msgid "MEL indicator"
msgstr "مؤشر MEL"

msgctxt "#32136"
msgid "Color of the pill shown on the splash logo when the source is Dolby Vision MEL."
msgstr "لون الشريط المعروض على شعار البداية عندما يكون المصدر Dolby Vision MEL."

msgctxt "#32137"
msgid "Other Dolby Vision"
msgstr "دولبي فيجن آخر"

msgctxt "#32138"
msgid "Color of the pill shown on the splash logo for any other Dolby Vision profile (no enhancement layer)."
msgstr "لون الشريط المعروض على شعار البداية لأي ملف تعريف آخر من دولبي فيجن (بدون طبقة تحسين)."

msgctxt "#32139"
msgid "Video OSD"
msgstr "OSD الفيديو"

msgctxt "#32140"
msgid "Show codec logos in the video OSD"
msgstr "عرض شعارات الترميز في OSD الفيديو"

msgctxt "#32141"
msgid "Also shows the format logos whenever the on-screen playback controls (video OSD) are visible."
msgstr "يعرض أيضًا شعارات الصيغة كلما ظهرت عناصر التحكم بالتشغيل على الشاشة (OSD الفيديو)."

msgctxt "#32142"
msgid "Show codec logos in the TinyPPI overlay"
msgstr "عرض شعارات الترميز في طبقة TinyPPI"

msgctxt "#32143"
msgid "Also shows the format logos while the TinyPPI info overlay is open."
msgstr "يعرض أيضًا شعارات الصيغة أثناء فتح طبقة معلومات TinyPPI."

msgctxt "#32144"
msgid "Layout"
msgstr "التخطيط"

msgctxt "#32145"
msgid "Dialog layout"
msgstr "تخطيط مربع الحوار"

msgctxt "#32146"
msgid "Which of the designs the VS10 dialog is drawn as."
msgstr "يحدد التصميم الذي يُرسم به مربع حوار VS10."

msgctxt "#32147"
msgid "Single button"
msgstr "زر واحد"

msgctxt "#32148"
msgid "Bar"
msgstr "شريط"

msgctxt "#32149"
msgid "Dialog"
msgstr "مربع الحوار"

msgctxt "#32150"
msgid "Dialog position"
msgstr "موضع مربع الحوار"

msgctxt "#32151"
msgid "Vertical position"
msgstr "الموضع الرأسي"

msgctxt "#32152"
msgid "Where the dialog sits between the top edge of the screen (0%) and the bottom one (100%). 50% leaves it in the middle, where it has always been."

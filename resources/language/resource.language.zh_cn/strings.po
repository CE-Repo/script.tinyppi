msgstr "滚动条"

msgctxt "#32421"
msgid "Color of the scrollbar down the right-hand edge."
msgstr "右侧边缘滚动条的颜色。"

msgctxt "#32422"
msgid "Key hint"
msgstr "按键提示"

msgctxt "#32423"

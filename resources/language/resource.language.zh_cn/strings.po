msgstr "自定义"

msgctxt "#32251"
msgid "Separator line"
msgstr "分隔线"

msgctxt "#32252"
msgid "Color of the separator lines."
msgstr "分隔线的颜色。"

msgctxt "#32253"
msgid "Dialog selection"
msgstr "对话框选中"

msgctxt "#32254"
msgid "Background color of the focused button in the VS10 dialog."
msgstr "VS10 对话框中聚焦按钮的背景颜色。"

msgctxt "#32255"
msgid "Dialog selection text"
msgstr "对话框选中文本"

msgctxt "#32256"
msgid "Text color of the focused button in the VS10 dialog."
msgstr "VS10 对话框中聚焦按钮的文本颜色。"

msgctxt "#32257"
msgid "[COLOR=FF000000]●[/COLOR] Black (Default)"
msgstr "[COLOR=FF000000]●[/COLOR] 黑色（默认）"

msgctxt "#32258"
msgid "[COLOR=FFFFFFFF]●[/COLOR] White"
msgstr "[COLOR=FFFFFFFF]●[/COLOR] 白色"

msgctxt "#32260"
msgid "Overlay position"
msgstr "叠加层位置"

msgctxt "#32261"
msgid "Horizontal offset"
msgstr "水平偏移"

msgctxt "#32262"
msgid "Shifts the overlay to the right from its default position. 100% is the maximum shift that keeps the content on screen."
msgstr "将叠加层从默认位置向右移动。100% 为保持内容完全显示在屏幕内的最大移动量。"

msgctxt "#32263"
msgid "Vertical offset"
msgstr "垂直偏移"

msgctxt "#32264"
msgid "Shifts the overlay upwards from its default position. 100% is the maximum shift that keeps the content on screen."
msgstr "将叠加层从默认位置向上移动。100% 为保持内容完全显示在屏幕内的最大移动量。"

msgctxt "#32266"
msgid "Opacity of the overlay background, from 0% (fully transparent) to 100% (fully opaque)."
msgstr "叠加层背景的不透明度，从 0%（完全透明）到 100%（完全不透明）。"

msgctxt "#32267"
msgid "Transparency"
msgstr "透明度"

msgctxt "#32268"
msgid "Opacity of the full-screen background behind the overlay, from 0% (off) to 100% (fully opaque)."
msgstr "叠加层后面全屏背景的不透明度，从 0%（关闭）到 100%（完全不透明）。"

msgctxt "#32269"
msgid "Global background"
msgstr "全局背景"

msgctxt "#32271"
msgid "Color of the full-screen global background."
msgstr "全屏全局背景的颜色。"

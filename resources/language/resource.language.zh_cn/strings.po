msgstr "[COLOR=FFFFFFFF]●[/COLOR] 白色"

msgctxt "#32260"
msgid "Overlay position"
msgstr "叠加层位置"

msgctxt "#32261"
msgid "Horizontal offset (SDR only)"
msgstr "水平偏移 (仅 SDR)"

msgctxt "#32262"
msgid "Shifts the overlay to the right from its default position. 100% is the maximum shift that keeps the content on screen."
msgstr "将叠加层从默认位置向右移动。100% 为保持内容完全显示在屏幕内的最大移动量。"

msgctxt "#32263"
msgid "Vertical offset"
msgstr "垂直偏移"

msgctxt "#32264"
msgid "Shifts the overlay upwards from its default position. 100% is the maximum shift that keeps the content on screen."
msgstr "将叠加层从默认位置向上移动。100% 为保持内容完全显示在屏幕内的最大移动量。"

msgctxt "#32266"
msgid "Opacity of the overlay background, from 0% (fully transparent) to 100% (fully opaque)."
msgstr "叠加层背景的不透明度，从 0%（完全透明）到 100%（完全不透明）。"

msgctxt "#32267"
msgid "Transparency"
msgstr "透明度"

msgctxt "#32268"
msgid "Opacity of the full-screen background behind the overlay, from 0% (off) to 100% (fully opaque)."
msgstr "叠加层后面全屏背景的不透明度，从 0%（关闭）到 100%（完全不透明）。"

msgctxt "#32269"
msgid "Global background"
msgstr "全局背景"

msgctxt "#32271"
msgid "Color of the full-screen global background."
msgstr "全屏全局背景的颜色。"

msgctxt "#32274"
msgid "Opacity of this element, from 0% (fully transparent) to 100% (fully opaque)."
msgstr "此元素的不透明度，从 0%（完全透明）到 100%（完全不透明）。"

msgctxt "#32275"
msgid "Conversion (yes)"
msgstr "转换（是）"

msgctxt "#32276"
msgid "Color of the check-circle icon shown when conversion is active."
msgstr "转换进行时显示的对勾圆圈图标的颜色。"

msgctxt "#32277"
msgid "Conversion (no)"
msgstr "转换（否）"

msgctxt "#32278"
msgid "Color of the cross-circle icon shown when conversion is inactive."
msgstr "转换未进行时显示的叉号圆圈图标的颜色。"

msgctxt "#32279"
msgid "FEL tag"
msgstr "FEL 标记"

msgctxt "#32280"
msgid "Color of the FEL enhancement-layer tag in the output mode."
msgstr "输出模式中 FEL 增强层标记的颜色。"

msgctxt "#32281"
msgid "MEL tag"
msgstr "MEL 标记"

msgctxt "#32282"
msgid "Color of the MEL enhancement-layer tag in the output mode."
msgstr "输出模式中 MEL 增强层标记的颜色。"

